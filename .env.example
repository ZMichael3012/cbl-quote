# Local environment variables for cbl-quote.
HTTP_ADDR=:8070
GRPC_ADDR=:9070
METRICS_ADDR=:9270
PG_DSN=postgres://cbl:cbl@localhost:5432/quote?sslmode=disable
REDIS_URL=redis://:cbl@localhost:6379/0
# Alternative via separate settings: REDIS_ADDR=localhost:6379 and REDIS_PASSWORD=secret
RATE_SOURCE=config
RATE_CONFIG={"USDT/RUB":"95.50","BTC/USDT":"60000.00"}
RATE_MAX_SPREAD_PCT=2
RATE_ANOMALY_PCT=10
RATE_ANOMALY_RESET=15m
RATE_ALLOWED_IDENTICAL_PAIRS=USDT/USD
# Per-pair minimums: CSV BASE/QUOTE@ASSET:MINOR (ASSET is one side, MINOR in its minor units); empty disables.
RATE_MIN_AMOUNTS=
RATE_CACHE_TTL=5s
RATE_LAST_TTL=1h
LOCK_QUOTE_TTL=5m
LOCK_QUOTE_MAX_TTL=15m
